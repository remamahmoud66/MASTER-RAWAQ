digraph RAWAQ_ERD {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.35", ranksep="1.1", splines=spline, fontname="Helvetica", labelloc=t, fontsize=24, fontcolor="#55212d", label=<<B>RAWAQ — Database ER Diagram (v4)</B><BR/><FONT POINT-SIZE="12" COLOR="#766d6f">MySQL 8 · 13 tables · crow's foot notation: ||  exactly one   o|  zero or one   o&lt;  zero or many   |&lt;  one or many</FONT>>];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#9c7b83", penwidth=1.3, arrowsize=0.9, fontname="Helvetica", fontsize=9, fontcolor="#722f3e", dir=both];
  subgraph cluster_0 { label=<<B>Accounts</B>>; fontsize=12; fontcolor="#55212d"; style="rounded,filled"; fillcolor="#f6eef0"; color="#e2d6d8"; margin=14;
  users [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT" PORT="full_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(190)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT" PORT="password_hash"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="gender_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">gender</TD><TD ALIGN="LEFT" PORT="gender"><FONT COLOR="#8a7d80" POINT-SIZE="9">ENUM(male,female)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT" PORT="phone"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(30) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT" PORT="role"><FONT COLOR="#8a7d80" POINT-SIZE="9">ENUM(customer,admin)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8a7d80" POINT-SIZE="9">TIMESTAMP</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label=<<B>Products &amp; add-ons  (screen 6)</B>>; fontsize=12; fontcolor="#55212d"; style="rounded,filled"; fillcolor="#f7f2ec"; color="#e2d6d8"; margin=14;
  product_categories [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>product_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT" PORT="category_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT" PORT="category_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="icon_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">icon</TD><TD ALIGN="LEFT" PORT="icon"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR></TABLE>>];
  products [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT" PORT="product_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT" PORT="category_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_name_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT" PORT="product_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT" PORT="price"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="icon_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">icon / image_path</TD><TD ALIGN="LEFT" PORT="icon"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR></TABLE>>];
  add_ons [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>add_ons</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="add_on_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>add_on_id</B></TD><TD ALIGN="LEFT" PORT="add_on_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="add_on_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">add_on_name</TD><TD ALIGN="LEFT" PORT="add_on_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT" PORT="price"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 { label=<<B>Basket design collection  (screen 5)</B>>; fontsize=12; fontcolor="#55212d"; style="rounded,filled"; fillcolor="#f1f4ee"; color="#e2d6d8"; margin=14;
  basket_categories [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>basket_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basket_category_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>basket_category_id</B></TD><TD ALIGN="LEFT" PORT="basket_category_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT" PORT="category_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="icon_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">icon</TD><TD ALIGN="LEFT" PORT="icon"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR></TABLE>>];
  basket_designs [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>basket_designs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basket_design_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>basket_design_id</B></TD><TD ALIGN="LEFT" PORT="basket_design_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basket_category_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">basket_category_id</TD><TD ALIGN="LEFT" PORT="basket_category_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="design_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">design_name</TD><TD ALIGN="LEFT" PORT="design_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="extra_price_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">extra_price</TD><TD ALIGN="LEFT" PORT="extra_price"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_3 { label=<<B>Message cards  (screen 7 — optional)</B>>; fontsize=12; fontcolor="#55212d"; style="rounded,filled"; fillcolor="#f4eff6"; color="#e2d6d8"; margin=14;
  card_categories [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>card_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="card_category_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>card_category_id</B></TD><TD ALIGN="LEFT" PORT="card_category_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT" PORT="category_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(80)</FONT></TD></TR></TABLE>>];
  card_designs [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>card_designs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="card_design_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>card_design_id</B></TD><TD ALIGN="LEFT" PORT="card_design_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="card_category_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">card_category_id</TD><TD ALIGN="LEFT" PORT="card_category_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="design_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">design_name</TD><TD ALIGN="LEFT" PORT="design_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="icon_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">icon / image_path</TD><TD ALIGN="LEFT" PORT="icon"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_4 { label=<<B>Ready-made baskets  (screen 3)</B>>; fontsize=12; fontcolor="#55212d"; style="rounded,filled"; fillcolor="#eef3f5"; color="#e2d6d8"; margin=14;
  ready_made_baskets [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>ready_made_baskets</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ready_made_basket_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>ready_made_basket_id</B></TD><TD ALIGN="LEFT" PORT="ready_made_basket_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basket_name_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">basket_name</TD><TD ALIGN="LEFT" PORT="basket_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="theme_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">theme</TD><TD ALIGN="LEFT" PORT="theme"><FONT COLOR="#8a7d80" POINT-SIZE="9">ENUM(breakfast,coffee,combination)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT" PORT="price"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR></TABLE>>];
  ready_made_basket_items [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>ready_made_basket_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ready_made_basket_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><B>ready_made_basket_id</B></TD><TD ALIGN="LEFT" PORT="ready_made_basket_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT" PORT="product_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT" PORT="quantity"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_5 { label=<<B>Orders  (screens 4 → 8)</B>>; fontsize=12; fontcolor="#55212d"; style="rounded,filled"; fillcolor="#fbf3ef"; color="#e2d6d8"; margin=14;
  orders [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>order_id</B></TD><TD ALIGN="LEFT" PORT="order_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_reference_l" WIDTH="38"><FONT COLOR="#6b6b6b" POINT-SIZE="9"><B>UK</B></FONT></TD><TD ALIGN="LEFT">order_reference</TD><TD ALIGN="LEFT" PORT="order_reference"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT" PORT="user_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ready_made_basket_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">ready_made_basket_id</TD><TD ALIGN="LEFT" PORT="ready_made_basket_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basket_design_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">basket_design_id</TD><TD ALIGN="LEFT" PORT="basket_design_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="budget_amount_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">budget_amount</TD><TD ALIGN="LEFT" PORT="budget_amount"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="budget_is_flexible_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">budget_is_flexible</TD><TD ALIGN="LEFT" PORT="budget_is_flexible"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="card_design_id_l" WIDTH="38"><FONT COLOR="#2f6f8f" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT">card_design_id</TD><TD ALIGN="LEFT" PORT="card_design_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="card_message_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">card_message</TD><TD ALIGN="LEFT" PORT="card_message"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(220) NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_gift_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">is_gift</TD><TD ALIGN="LEFT" PORT="is_gift"><FONT COLOR="#8a7d80" POINT-SIZE="9">TINYINT(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_name_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">delivery_name / phone</TD><TD ALIGN="LEFT" PORT="delivery_name"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_location_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">delivery_location</TD><TD ALIGN="LEFT" PORT="delivery_location"><FONT COLOR="#8a7d80" POINT-SIZE="9">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_date_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">delivery_date</TD><TD ALIGN="LEFT" PORT="delivery_date"><FONT COLOR="#8a7d80" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="products_total_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">products_total</TD><TD ALIGN="LEFT" PORT="products_total"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="add_ons_total_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">add_ons_total</TD><TD ALIGN="LEFT" PORT="add_ons_total"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_fee_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">delivery_fee</TD><TD ALIGN="LEFT" PORT="delivery_fee"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2) = 2.00</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT" PORT="total_amount"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_status_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">order_status</TD><TD ALIGN="LEFT" PORT="order_status"><FONT COLOR="#8a7d80" POINT-SIZE="9">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8a7d80" POINT-SIZE="9">TIMESTAMP</FONT></TD></TR></TABLE>>];
  order_items [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><B>order_id</B></TD><TD ALIGN="LEFT" PORT="order_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT" PORT="product_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT" PORT="quantity"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT" PORT="unit_price"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR></TABLE>>];
  order_add_ons [label=<<TABLE BORDER="1" COLOR="#c9b3b9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#722f3e"><FONT COLOR="white" POINT-SIZE="12"><B>order_add_ons</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><B>order_id</B></TD><TD ALIGN="LEFT" PORT="order_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="add_on_id_l" WIDTH="38"><FONT COLOR="#b8860b" POINT-SIZE="9"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT"><B>add_on_id</B></TD><TD ALIGN="LEFT" PORT="add_on_id"><FONT COLOR="#8a7d80" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price_l" WIDTH="38"><FONT COLOR="#ffffff" POINT-SIZE="9"><B> </B></FONT></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT" PORT="unit_price"><FONT COLOR="#8a7d80" POINT-SIZE="9">DECIMAL(8,2)</FONT></TD></TR></TABLE>>];
  }
  product_categories:category_id -> products:category_id_l [arrowtail=teetee, arrowhead=crowodot, label="groups"];
  basket_categories:basket_category_id -> basket_designs:basket_category_id_l [arrowtail=teetee, arrowhead=crowodot, label="has designs"];
  card_categories:card_category_id -> card_designs:card_category_id_l [arrowtail=teetee, arrowhead=crowodot, label="has designs"];
  ready_made_baskets:ready_made_basket_id -> ready_made_basket_items:ready_made_basket_id_l [arrowtail=teetee, arrowhead=crowtee, label="contains"];
  products:product_id -> ready_made_basket_items:product_id_l [arrowtail=teetee, arrowhead=crowodot, label="included in"];
  users:user_id -> orders:user_id_l [arrowtail=teeodot, arrowhead=crowodot, label="places"];
  ready_made_baskets:ready_made_basket_id -> orders:ready_made_basket_id_l [arrowtail=teeodot, arrowhead=crowodot, label="ordered as"];
  basket_designs:basket_design_id -> orders:basket_design_id_l [arrowtail=teeodot, arrowhead=crowodot, label="presented in"];
  card_designs:card_design_id -> orders:card_design_id_l [arrowtail=teeodot, arrowhead=crowodot, label="optional card"];
  orders:order_id -> order_items:order_id_l [arrowtail=teetee, arrowhead=crowodot, label="contains"];
  products:product_id -> order_items:product_id_l [arrowtail=teetee, arrowhead=crowodot, label="ordered as"];
  orders:order_id -> order_add_ons:order_id_l [arrowtail=teetee, arrowhead=crowodot, label="includes"];
  add_ons:add_on_id -> order_add_ons:add_on_id_l [arrowtail=teetee, arrowhead=crowodot, label="selected as"];
}